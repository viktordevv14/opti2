rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /patients/{patientId} {
      allow read, write: if true;
    }

    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }

    match /payments/{paymentId} {
      allow read, write: if true;
    }

    match /frames/{frameId} {
      allow read, write: if true;
    }
  }
}
