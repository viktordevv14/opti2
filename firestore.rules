rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Security rules for OptiCare patient and prescription data
    
    // Allow reading and writing patients
    match /patients/{patientId} {
      // In a production app, you should restrict this to authenticated users
      // example: allow read, write: if request.auth != null;
      allow read, write: if true; 
    }
    
    // Allow reading and writing prescriptions
    match /prescriptions/{prescriptionId} {
      allow read, write: if true;
    }
  }
}
